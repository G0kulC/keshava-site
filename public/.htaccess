# Keshava Fabrics — Apache / LiteSpeed config (Hostinger).
# Every page is a prerendered folder with index.html, so no SPA fallback is needed.

Options -MultiViews -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── One canonical host: https://keshavafabrics.in ─────────────────────
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://keshavafabrics.in%{REQUEST_URI} [L,R=301,NE]

  # ── Old WordPress / WooCommerce URLs ─────────────────────────────────
  # Strip WooCommerce add-to-cart query strings.
  RewriteCond %{QUERY_STRING} (^|&)add-to-cart= [NC]
  RewriteRule ^ %{REQUEST_URI}? [L,R=301]

  RewriteRule ^(cart|checkout|my-account|wishlist|compare)(/.*)?$ /shop/ [L,R=301]
  RewriteRule ^(feed|comments/feed)/?$ / [L,R=301]
  RewriteRule ^wp-sitemap.*\.xml$ /sitemap.xml [L,R=301]
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php|wp-json|wp-includes)(/.*)?$ - [G,L]

  # Old image URLs → new local copies (keeps Google Images rankings).
  RewriteRule ^wp-content/uploads/2026/01/keshava-fabrics\.png$ /brand/keshava-fabrics.png [L,R=301]
  RewriteCond %{DOCUMENT_ROOT}/images/products/$1 -f
  RewriteRule ^wp-content/uploads/\d{4}/\d{2}/([^/]+)$ /images/products/$1 [L,R=301]
  RewriteCond %{DOCUMENT_ROOT}/images/categories/$1 -f
  RewriteRule ^wp-content/uploads/\d{4}/\d{2}/([^/]+)$ /images/categories/$1 [L,R=301]
  RewriteCond %{DOCUMENT_ROOT}/images/blog/$1 -f
  RewriteRule ^wp-content/uploads/\d{4}/\d{2}/([^/]+)$ /images/blog/$1 [L,R=301]

  # Short URLs used by earlier builds of this site.
  RewriteRule ^about/?$ /about-us/ [L,R=301]
  RewriteRule ^contact/?$ /contact-us/ [L,R=301]
  RewriteRule ^policies/shipping/?$ /shipping-policy/ [L,R=301]
  RewriteRule ^policies/returns/?$ /return-and-refund-policy/ [L,R=301]
  RewriteRule ^policies/bulk-orders/?$ /bulk-order-policy/ [L,R=301]
  RewriteRule ^policies/privacy/?$ /privacy-policy/ [L,R=301]
  RewriteRule ^policies/terms/?$ /terms-conditions/ [L,R=301]
  RewriteRule ^blog/([^/]+)/?$ /$1/ [L,R=301]

  # ── Trailing slash on page URLs (matches canonical tags) ─────────────
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

# ── Compression ─────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# ── Caching ─────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Hashed build assets never change.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.(webp|png|jpe?g|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Pages must always be fresh so updates show immediately.
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
